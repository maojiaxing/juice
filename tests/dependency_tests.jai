test "Import shim prefers the root layout over src" {
    packages := otter_scratch("dep-test-shim-both");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    source := tprint("%1/tests/data/dep-fixture/both-pkg", otter_root());
    expect(ensure_import_shim(packages, "both-pkg", source));
    abs_source, _ := normalize_existing_path(source);
    content, ok := shim_content_for(packages, "both-pkg");
    expect(ok && content == dependency_shim_content("both-pkg", tprint("%1/module.jai", abs_source)));
}

test "Import shim skipped without any layout" {
    packages := otter_scratch("dep-test-shim-none");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    expect(ensure_import_shim(packages, "empty-pkg", tprint("%1/tests/data/dep-fixture/empty-pkg", otter_root())));
    _, shim_written := shim_content_for(packages, "empty-pkg");
    expect(!shim_written);
}

// normalize_existing_path never verifies existence (measured in ticket
// 008), so a missing source directory falls through every layout probe —
// same as the no-layout branch: no shim, no error, resolution left to the
// compiler.
test "Import shim skips a missing source directory" {
    packages := otter_scratch("dep-test-shim-missing");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    expect(ensure_import_shim(packages, "nope", otter_scratch("dep-test-nonexistent")));
    _, shim_written := shim_content_for(packages, "nope");
    expect(!shim_written);
}

// ---------------------------------------------------------------------------
// Workspace dependency preparation: members link by declared name (the DEP
// source is ignored), everything else fetches; a failure anywhere
// propagates. Every package's declared closure is processed — there is no
// transitive resolution.
// ---------------------------------------------------------------------------

test "Workspace member dependencies are linked not fetched" {
    reset_dependency_recording();
    test_fetch_result = true;
    test_link_result = true;
    packages := Juice.Package.[
        .{name = "root", dependencies = Juice.Dependency.[.{name = "member-lib"}, .{name = "external"}]},
        .{name = "member-lib", dependencies = Juice.Dependency.[.{name = "external2"}]},
    ];
    expect(fetch_workspace_dependencies("", "", packages, test_fake_fetch, test_fake_link_member));
    expect(test_fetched_dependency_names.count == 2);
    expect(test_fetched_dependency_names[0] == "external" && test_fetched_dependency_names[1] == "external2");
    expect(test_linked_member_names.count == 1 && test_linked_member_names[0] == "member-lib");
}

test "Member link failure propagates" {
    reset_dependency_recording();
    test_fetch_result = true;
    test_link_result = false;
    packages := Juice.Package.[
        .{name = "root", dependencies = Juice.Dependency.[.{name = "member-lib"}, .{name = "external"}]},
        .{name = "member-lib"},
    ];
    expect(!fetch_workspace_dependencies("", "", packages, test_fake_fetch, test_fake_link_member));
    expect(test_linked_member_names.count == 1 && test_fetched_dependency_names.count == 0);
}

test "Dependency fetch failure propagates" {
    reset_dependency_recording();
    test_fetch_result = false;
    test_link_result = true;
    packages := Juice.Package.[.{name = "root", dependencies = Juice.Dependency.[.{name = "external"}]}];
    expect(!fetch_workspace_dependencies("", "", packages, test_fake_fetch, test_fake_link_member));
    expect(test_fetched_dependency_names.count == 1);
}

test "Find workspace member matches by declared name" {
    packages := Juice.Package.[.{name = "root"}, .{name = "member-lib"}];
    member, found := find_workspace_member(packages, "member-lib");
    expect(found && member.name == "member-lib");
    _, missing := find_workspace_member(packages, "nope");
    expect(!missing);
}

// DEP.name is used verbatim and never validated: a hetero-name DEP
// ({name = "juice_core", source = ...} + #import "juice_core") is the
// official cross-package form — the shim lands under the declared name,
// whatever the package behind the source calls itself.
test "Dependency names are used verbatim" {
    root := otter_scratch("dep-test-hetero");
    delete_directory_full(root);
    defer delete_directory_full(root);
    make_directory_if_it_does_not_exist(packages_dir(root), recursive = true);
    source := tprint("%1/tests/data/dep-fixture/shim-pkg", otter_root());
    dep: Juice.Dependency;
    dep.name = "juice_core";
    dep.source = source;
    expect(fetch_dependency(root, tprint("%1/cache", root), dep));
    abs_source, _ := normalize_existing_path(source);
    content, ok := shim_content_for(packages_dir(root), "juice_core");
    expect(ok && content == dependency_shim_content("juice_core", tprint("%1/src/module.jai", abs_source)));
    _, hetero := shim_content_for(packages_dir(root), "shim-pkg");
    expect(!hetero);
}

// The dependency directory is built before the snapshot is consumed; a
// member entry then links its real directory (the production link path,
// no seams).
test "Dependency preparation builds the shim directory and links members" {
    root := otter_scratch("dep-test-prep");
    delete_directory_full(root);
    defer delete_directory_full(root);
    member_dir := tprint("%1/tests/data/dep-fixture/root-pkg", otter_root());
    packages := Juice.Package.[
        .{name = "root", dependencies = Juice.Dependency.[.{name = "root-pkg"}]},
        .{name = "root-pkg", dir = member_dir},
    ];
    expect(resolve_and_fetch_dependencies(root, tprint("%1/cache", root), packages));
    expect(is_directory(packages_dir(root)));
    abs_member, _ := normalize_existing_path(member_dir);
    content, ok := shim_content_for(packages_dir(root), "root-pkg");
    expect(ok && content == dependency_shim_content("root-pkg", tprint("%1/module.jai", abs_member)));
}

// ---------------------------------------------------------------------------
// E2E: the generated driver child discovers workspace-ok through real jai
// evaluator children, prepares its declared snapshot against a scratch root
// (member_lib and member_extra link by declared name — member_extra's
// member-relative source "../member_lib" is ignored by member linking, so
// it never misresolves against the root cwd), and fetches one non-member
// DEP whose relative source anchors at the child's cwd (the package root in
// production, since juice never chdirs).
// ---------------------------------------------------------------------------

test "E2E: dependency preparation consumes the declared snapshot" {
    scratch := otter_scratch("dep-e2e-scratch");
    result, output, _ := run_dependency_prep_child("workspace-ok", scratch);
    expect(expect_exit("dep-prep", result, 0, "dependency child"));
    expect(output_matches("dep-prep", output, string.[
        "discovery-ok=true",
        "deps-ok=true",
        "rel-ok=true",
    ]));
    packages := packages_dir(scratch);
    member_lib_dir, _ := normalize_existing_path(tprint("%1/tests/data/workspace-ok/member_lib", otter_root()));
    member_extra_dir, _ := normalize_existing_path(tprint("%1/tests/data/workspace-ok/member_extra", otter_root()));
    content, ok := shim_content_for(packages, "member_lib");
    expect(ok && content == dependency_shim_content("member_lib", tprint("%1/src/module.jai", member_lib_dir)));
    content, ok = shim_content_for(packages, "member_extra");
    expect(ok && content == dependency_shim_content("member_extra", tprint("%1/module.jai", member_extra_dir)));
    // The relative source anchors at the child cwd (otter root — the
    // package root in production): the hetero-name shim loads the real
    // entry of the package behind the source.
    abs_source, _ := normalize_existing_path(tprint("%1/tests/data/dep-fixture/shim-pkg", otter_root()));
    content, ok = shim_content_for(packages, "dep_rel");
    expect(ok && content == dependency_shim_content("dep_rel", tprint("%1/src/module.jai", abs_source)));
}
