    abs_source, _ := normalize_existing_path(source);
    content, ok := shim_content_for(packages, "file-pkg");
    expect(ok && content == dependency_shim_content("file-pkg", tprint("%1/file-pkg.jai", abs_source)));
}

test "Import shim generated for a root module.jai entry" {
    packages := otter_scratch("dep-test-shim-root");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    source := tprint("%1/tests/data/dep-fixture/root-pkg", otter_root());
