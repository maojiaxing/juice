#import "Basic";
#import "Testing";

// ---------------------------------------------------------------------------
// Dependency tests: source-type detection, shim generation (the three entry
// layout probes and the shim shape byte for byte), the member-link/fetch
// split with the recording fakes, DEP.name verbatim consumption and the
// relative-source cwd anchor (old juice workspace.jai/dependency.jai inline
// test semantics, migrated to the sister test file per the test
// organization rule). Scratch trees live under target/dep-test-*; the
// dep-fixture layouts live under tests/data/dep-fixture.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Source types and path derivations.
// ---------------------------------------------------------------------------

test "Dependency source type detection matrix" {
    expect(detect_source_type("") == .LOCAL_PATH);
    expect(detect_source_type("file:///abs/path") == .LOCAL_PATH);
    expect(detect_source_type("https://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("http://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("git://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("ssh://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("git+https://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("git+ssh://github.com/x/y") == .GIT_URL);
    expect(detect_source_type("git@github.com:x/y") == .GIT_URL);
    expect(detect_source_type("https://github.com/x/y.git") == .GIT_URL);
    expect(detect_source_type("relative/path") == .LOCAL_PATH);
    expect(detect_source_type("C:/abs/path") == .LOCAL_PATH);
}

test "Local dependency path cleaning" {
    expect(clean_local_path("file:///abs/path") == "/abs/path");
    expect(clean_local_path("file://rel/path") == "rel/path");
    expect(clean_local_path("rel/path") == "rel/path");
}

test "Dependency packages directory derivation" {
    expect(packages_dir("C:/root") == "C:/root/target/packages");
}

test "Git repo cache path sanitization" {
    expect(get_git_repo_cache_path("C:/cache", "https://github.com/x/y.git", "") == "C:/cache/https___github_com_x_y_git");
    expect(get_git_repo_cache_path("C:/cache", "https://github.com/x/y.git", "v1") == "C:/cache/https___github_com_x_y_git_v1");
}

// ---------------------------------------------------------------------------
// Import shims: one generated shim per dependency, #loading the real entry
// by path — module.jai at the root first, then src/module.jai, then a
// single <name>.jai file. No recognizable layout writes no shim and leaves
// resolution to the compiler.
// ---------------------------------------------------------------------------

test "Import shim content shape" {
    expect(dependency_shim_content("depx", "C:/x/src/module.jai") ==
        "// Generated by juice: import shim for package 'depx'.\n#load \"C:/x/src/module.jai\";\n");
}

test "Import shim generated for a src/module.jai entry" {
    packages := otter_scratch("dep-test-shim-src");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    source := tprint("%1/tests/data/dep-fixture/shim-pkg", otter_root());
    expect(ensure_import_shim(packages, "shim-pkg", source));
    abs_source, _ := normalize_existing_path(source);
    content, ok := shim_content_for(packages, "shim-pkg");
    expect(ok && content == dependency_shim_content("shim-pkg", tprint("%1/src/module.jai", abs_source)));
}

test "Import shim generated for a single-file layout" {
    packages := otter_scratch("dep-test-shim-file");
    delete_directory_full(packages);
    make_directory_if_it_does_not_exist(packages, recursive = true);
    defer delete_directory_full(packages);
    source := tprint("%1/tests/data/dep-fixture/file-pkg", otter_root());
