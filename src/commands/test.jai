#import "Basic";
#import "File";
#import "File_Utilities";
#import "String";

// `juice test` (spec section 7, the old juice commands/test.jai semantics
// with ticket 028's 1c wiring): argument guard -> workspace preparation ->
// deterministic file collection (the scan_walk skeleton plus the test
// discovery exclusion set, ticket 015's handover) -> command-level plugin
// preparation (ticket 060: the shared prepare scans the declared member
// plugins, writes the registration file and reports whether a PRESTEP host
// is needed; the registration feeds both the host and the generated test
// metaprogram — no second scan) -> the PRESTEP stage (ticket 057: the pre-step
// plugin stage — the host's returned effects and the before hooks fill the
// source substitution table and drop set, after hooks observe; no built-in
// implementation, undeclared = no-op) -> the TRANSPILE stage (t3: per-file
// EXPAND with global base-1 numbering continuing across files — ticket 023's
// caller-side contract, with ticket 057's per-file substitution/drop
// consumption; t5/t8: content-addressed view landing with cache-hit skip;
// t9: the Testing module compile view special case; t11: the dependency
// strip front — dependency tests are neither discovered nor executed) ->
// the COMPILE stage (t12: the test runner entry + spawned jai + exit code
// passthrough; the entry is generated by src/test_runner.jai). The test list
// itself is discovered by the
// generated metaprogram's note enumeration during the compile (single
// compilation, ticket 003 decision 6): EXPAND-generated juice_test_N
// procedures carry @test notes exactly like hand-written @test procedures,
// so both styles unify under one discovery source (spec section 7.1). The
// pattern filter, the zero-entry short circuit and the zero-match report
// live in the generated text (src/test_runner.jai +
// src/test_discovery.jai); this command only short-circuits the zero-FILE
// case before spawning.
//
// The PRESTEP, TRANSPILE and COMPILE stages dispatch through the lifecycle
// hook table (spec §6, the 004 decision 17 representative subset extended by
// ticket 057 — the same shape as build's dispatch, ticket 027): before hooks
// run first, a mounted at hook replaces the stage's built-in implementation
// (no mount = the built-in runs — the empty hook set is the default
// pipeline; PRESTEP has no built-in implementation and never dispatches at),
// after hooks run last, all in registration order (forward — ticket 021); any
// hook failure (false or an ERROR diagnostic) fails the stage, the command
// and the exit code (HANDLER_FAILED through the dispatcher). The at
// replacement's identity enters the pipeline description through the
// pipeline the hook passes to transpile_view_key — changing the
// implementation changes the view keys (documented semantics, the build
// side's ticket 027 deviation 2).

TEST_COMMAND :: Command.{
    name          = "test",
    description   = "Run unit tests in the root package",
    usage         = "juice test [pattern]",
    prerequisites = string.[],
    handler       = test_command,
    validate_arguments = test_arguments_are_valid,
};

test_arguments_are_valid :: (arguments: [] string) -> bool {
    return arguments.count <= 1;
}

test_command :: (ctx: *Command_Context, arguments: [] string) -> bool {
    if !command_arguments_are_valid(TEST_COMMAND, arguments) return false;
    // force_dependencies: a LIB package has no effective target, yet its
    // test program still references dependencies through import shims — Test
    // must prepare dependencies (the old juice posture).
    prepared := ensure_workspace_prepared(ctx.root_dir, ctx.cache_dir, *ctx.workspace, force_dependencies = true);
    if prepared == null return false;
    pattern := ifx arguments.count == 1 then arguments[0] else "";
    return test_prepared_workspace(prepared, pattern);
}

// The test scratch zone (target/tests) is owned by the test command: every
// run starts by pruning the previous run's scratch — stale fixture roots and
// E2E caches otherwise accumulate under the target tree. The recovery zone
// (target/recovery, crash backups) is deliberately outside this zone and
// survives. A missing zone is success (delete_directory_full returns true
// when the path does not exist); a failed delete fails the command loudly
// because a locked file in a tool-owned zone is a real problem.
prune_test_scratch :: (root_dir: string) -> bool {
    return delete_directory_full(target_tests_dir(package_target_dir(root_dir)));
}

// ---------------------------------------------------------------------------
// File collection: the scan_walk skeleton (ticket 015) plus the test
// discovery exclusion set — the production predicates 015 delegated to the
// first production consumer. Full discovery scan: recursively collects
// every lowercase ".jai" test source from the package root. Dot entries are
// excluded at any depth; the root-level target/ (managed products),
// tests/data/ (fixture directory) and modules/ (module directory) are
// excluded; the scan root's own manifest is excluded (a nested package.jai
// source file is user code and stays scanned); workspace member subtrees are
// pruned via the discovery snapshot (members run their tests as their own
// root); symlinks and junctions are not followed. A pre-step plugin's drop
// set (ticket 057) filters the collected list further at the PRESTEP stage.
// Enumeration order is the scan order: a deterministic DFS where each
// directory yields its files first (lexicographic by name) and then recurses
// into its subdirectories (lexicographic).
// ---------------------------------------------------------------------------

collect_test_files :: (prepared: *Juice.Prepared_Workspace) -> [] Scan_File, bool {
    collect: Test_Collect_Context;
    collect.root = prepared.discovery.root_dir;
    // Member boundaries come from the workspace discovery snapshot (root
    // package first); the scan consumes it without merging into discovery.
    for pkg, index: prepared.discovery.member_packages {
        if index == 0 continue;
        array_add(*collect.member_dirs, copy_string(pkg.dir));
    }
    files, ok := collect_scan_files(collect.root, *collect, collect_directory_is_excluded, collect_file_is_excluded);
    if !ok {
        print("[juice ERROR] Could not scan package root for test sources: %\n", collect.root);
        return Scan_File.[], false;
    }
    return files, true;
}

// The wrapper's exclusion context: the scan root plus the member boundaries
// consumed from the discovery snapshot.
Test_Collect_Context :: struct {
    root:        string;
    member_dirs: [..] string;
}

// Directory-side exclusions: dot entries at any depth; the
// root-level target/, tests/data/ and modules/ (same-named directories at
// other depths are user code); workspace member subtrees; and links of any
// kind — visit_files already skips symlink entries itself, Windows junctions
// surface as plain directories there, so they are inspected explicitly in
// line with the path_safety posture.
collect_directory_is_excluded :: (info: *File_Visit_Info, collect: *Test_Collect_Context) -> bool {
    if info.short_name.count > 0 && info.short_name[0] == #char "." return true;
    rel := scan_rel_path(info.full_name, collect.root);
    if paths_equal(rel, "target") || paths_equal(rel, "tests/data") || paths_equal(rel, "modules") return true;
    for member: collect.member_dirs {
        if paths_equal(info.full_name, member) return true;
    }
    entry := inspect_path_entry(info.full_name);
    return entry.is_symlink || entry.is_junction;
}

// File-side exclusions: dot entries at any depth, non-lowercase-.jai
// extensions and the scan root's own manifest (a nested source file that
// happens to be named package.jai is user code and stays scanned). A
// pre-step plugin may drop more files from the collected list at the
// PRESTEP stage (ticket 057's drop set).
collect_file_is_excluded :: (info: *File_Visit_Info, collect: *Test_Collect_Context) -> bool {
    if info.short_name.count > 0 && info.short_name[0] == #char "." return true;
    if !ends_with(info.short_name, ".jai") return true;
    if info.short_name == "package.jai" && paths_equal(scan_entry_parent(info.full_name), collect.root) return true;
    return false;
}

// ---------------------------------------------------------------------------
// t3: the per-file EXPAND step. The transpile step's output for one file:
// the expand-mode view text, the content-addressed cache key (pure function
// over path + source + mode + version + pipeline description + starting
// test number) and the test
// entries found in it (the transpile bookkeeping — the numbering
// continuation; discovery itself runs on the note enumeration). The shared
// scan record (Scan_File: package-relative path + absolute path) is the
// file shape.
// ---------------------------------------------------------------------------

Test_File_Output :: struct {
    view:        string;
    key:         string;
    tests:       [..] Test_Entry;
    diagnostics: [..] Transpile_Diagnostic;
}

// pipeline is the configured pipeline (spec 0060 decision 6); an empty
// pipeline means the default — every existing caller keeps its behavior
// unchanged.
transpile_test_file :: (file: Scan_File, next_test_number: s64, pipeline: [] Transpile_Plugin = .[]) -> Test_File_Output {
    output: Test_File_Output;
    source, ok := read_entire_file(file.abs_path);
    if !ok {
        array_add(*output.diagnostics, .{line = 0, column = 0, message = tprint("无法读取测试源文件: %1", file.abs_path)});
        return output;
    }
    ctx: Transpile_Context;
    ctx.mode = .EXPAND;
    ctx.path = file.rel_path;
    ctx.next_test_number = next_test_number;
    // ctx.plugins is a resizable array; copy the slice in so the context
    // owns its pipeline view.
    for plugin: pipeline array_add(*ctx.plugins, plugin);
    result := transpile_source(source, ctx);
    output.view = result.view;
    output.key = transpile_view_key(file.rel_path, source, .EXPAND, Load_Target.[], VIEW_CONTRACT_VERSION, ctx.plugins, next_test_number);
    output.tests = result.tests;
    output.diagnostics = result.diagnostics;
    return output;
}

// ---------------------------------------------------------------------------
// t9: the Testing module compile view special case. The module source file
// cannot be compiled by jai directly once test blocks are inlined, so the
// test program must point every `#import "Testing"` at the generated
// compile view (its directory is prepended to the metaprogram's import
// path, and the module loads exactly once so the global counts never
// split). When the package's own modules/Testing.jai exists (in_package),
// the view is EXPAND mode plus the Testing self-test segment appended with
// a #load of the test support view — the module is a sealed scope (how_to
// 151), so files #loaded inside it attach to the module's Module scope,
// which is what makes the self-test blocks' references to test support
// declarations visible; its test blocks also join the test list (global
// numbering continues, the metaprogram's whitelist admits the view's
// @test notes). For user packages without that file, the view is STRIP mode
// (test-free; assertion semantics identical to the source file), so the
// test report and counts change nothing. A missing module, a read failure
// or a test-free module returns the disabled result (#import the module
// source file as-is).
// ---------------------------------------------------------------------------

Testing_Module_View_Result :: struct {
    enabled:          bool;           // disabled = #import the module source as-is
    in_package:       bool;
    dir:              string;         // write directory target/transpile/testing-module
    view_path:        string;         // write file dir/Testing.jai
    view_text:        string;         // EXPAND (+support block) or STRIP view text
    tests:            [..] Test_Entry; // in-package self-test blocks (numbers continued)
    next_test_number: s64;            // global number after continuation
}

// The Testing assertion module's source file for the generator special case:
// the package's own modules/Testing.jai when present
// (in_package = true, its self-test blocks join the test list), otherwise
// the module next to the running executable (user packages). Returns an
// empty abs_path when no module exists. The rel_path is always
// "modules/Testing.jai": the module view's file name must stay Testing.jai
// so the import path resolves it as the Testing module.
testing_module_source :: (package_root: string) -> (file: Scan_File, in_package: bool) {
    rel := "modules/Testing.jai";
    pkg_path := tprint("%1/%2", package_root, rel);
    if path_exists_as_regular_file(pkg_path) {
        file: Scan_File;
        file.rel_path = rel;
        file.abs_path = path_slashes(pkg_path);
        return file, true;
    }
    global_path := tprint("%1/Testing.jai", juice_modules_dir());
    if path_exists_as_regular_file(global_path) {
        file: Scan_File;
        file.rel_path = rel;
        file.abs_path = path_slashes(global_path);
        return file, false;
    }
    return .{}, false;
}

testing_module_view :: (package_root: string, support_view: string, next_test_number: s64) -> Testing_Module_View_Result, bool {
    result: Testing_Module_View_Result;
    result.next_test_number = next_test_number;

    module_file, module_in_package := testing_module_source(package_root);
    if module_file.abs_path == "" return result, true;

    source, ok := read_entire_file(module_file.abs_path);
    if !ok || !pipeline_has_anchors(default_transpile_pipeline(), source, module_file.rel_path) return result, true;

    result.enabled = true;
    result.in_package = module_in_package;
    if module_in_package {
        // The package's own module: EXPAND view (numbers continue the global
        // sequence); its self-test blocks join the test list.
        module_result := transpile_test_file(module_file, next_test_number);
        if module_result.diagnostics.count > 0 {
            for diagnostic: module_result.diagnostics {
                print("[juice ERROR] %1:%2,%3: %4\n", module_file.rel_path, diagnostic.line, diagnostic.column, diagnostic.message);
            }
            return result, false;
        }
        result.view_text = module_result.view;
        result.tests = module_result.tests;
        result.next_test_number = next_test_number + module_result.tests.count;

        // The EXPAND compile view appends the self-test support block:
        // embedding the whole test support view would drag its #import chain
        // and declarations into the module's export list (the driver #loads
        // the same view into the application scope, and duplicates there
        // would clash), so only the Testing self-test segment (helper
        // declarations and record globals) is cut out, completed with
        // file-level imports and a self-contained root (see
        // testing_module_support_block).
        if support_view == "" {
            print("[juice ERROR] Testing 自测需要 tests/test_support.jai 视图，但未发现该文件。\n");
            return result, false;
        }
        support_block := testing_module_support_block(support_view);
        if support_block == "" {
            print("[juice ERROR] tests/test_support.jai 缺少 Testing 自测段标记。\n");
            return result, false;
        }
        result.view_text = tprint("%1\n\n%2", result.view_text, support_block);
    } else {
        // The assertion module source of a user package: STRIP view
        // (test-free compile view).
        strip_ctx: Transpile_Context;
        strip_ctx.mode = .STRIP;
        strip_ctx.path = module_file.rel_path;
        stripped := transpile_source(source, strip_ctx);
        if stripped.diagnostics.count > 0 {
            for diagnostic: stripped.diagnostics {
                print("[juice ERROR] %1:%2,%3: %4\n", module_file.rel_path, diagnostic.line, diagnostic.column, diagnostic.message);
            }
            return result, false;
        }
        result.view_text = stripped.view;
    }

    result.dir = target_testing_module_dir(package_target_dir(package_root));
    result.view_path = path_slashes(tprint("%1/Testing.jai", result.dir));
    return result, true;
}

// The self-test support block appended to the EXPAND module compile view:
// the Testing self-test segment of the test support view, cut out by the
// stable machine markers (renaming comments inside the segment never breaks
// the cut) — under #scope_file so the declarations stay in the module
// compile view's file scope (they must not enter the module's export list —
// the driver #loads the same view into the application scope and duplicates
// there would clash). The segment carries its own self-contained imports.
// Returns "" when a marker is missing.
testing_module_support_block :: (support_view: string) -> string {
    // Locate the marker lines: each marker occupies its own line and is
    // anchored as "newline + marker", so mentions inside comment text never
    // match.
    begin := find_index_from_left(support_view, "\n// __testing_module_support_begin__");
    if begin < 0 return "";
    begin += 1;
    end := find_index_from_left(support_view, "\n// __testing_module_support_end__");
    if end < 0 return "";
    end += 1;
    // The segment includes the whole end-marker line (the marker comment
    // travels into the module view with the segment, noting its origin and
    // the discipline).
    while end < support_view.count && support_view[end] != #char "\n" end += 1;
    if end < support_view.count end += 1;
    segment := slice(support_view, begin, end - begin);

    builder: String_Builder;
    print_to_builder(*builder, "#scope_file;\n");
    print_to_builder(*builder, "#import \"Basic\";\n");
    print_to_builder(*builder, "#import \"Compiler\";\n");
    print_to_builder(*builder, "#import \"File\";\n");
    print_to_builder(*builder, "#import \"Process\";\n");
    print_to_builder(*builder, "#import \"String\";\n");
    print_to_builder(*builder, "\n");
    print_to_builder(*builder, "%", segment);
    return builder_to_string(*builder);
}

// ---------------------------------------------------------------------------
// Lifecycle stage dispatch (spec §6.3, the 004 decision 17 representative
// subset): the test's TRANSPILE and COMPILE mounts — the same shape as
// build's (ticket 027). The stage state travels through the lifecycle
// context's observable-state slots (views/artifact_paths); the at hook
// reads and writes it. A mounted at hook owns the stage's implementation
// and its outputs; with no mount the built-in implementation runs — the
// production default.
// ---------------------------------------------------------------------------

// The TRANSPILE stage state: the input is the prepared workspace, the
// collected files and the PRESTEP stage's tables (ticket 057); the output is
// the per-file expand outputs and the content-addressed view paths, plus the
// Testing module compile view special-case state ("" = disabled). The
// resolved pipeline (declaration-driven, ticket 056) travels with the stage
// so the front uses one resolution result and the view keys carry exactly
// that pipeline description (the command resolves once, before PRESTEP; the
// front never re-resolves). A mounted at hook fills the outputs itself (the
// built-in COMPILE front consumes whatever it finds); the built-in front
// fills them through t3/t5-t9/t11.
Test_Transpile_Stage :: struct {
    prepared:            *Juice.Prepared_Workspace;
    files:               [] Scan_File;
    pipeline:            [] Transpile_Plugin;
    prestep:             *Prestep_Stage;   // PRESTEP's tables (null = none)
    outputs:             [..] Test_File_Output;
    view_paths:          [..] string;
    transpile_dir:       string;
    testing_module_dir:  string;   // target/transpile/testing-module, "" = disabled
    testing_module_view: string;   // the compile view file, "" = disabled
}

// The TRANSPILE stage's built-in implementation: the PRESTEP table
// consumption, the t3 per-file EXPAND loop with global numbering, the t5/t8
// content-addressed view landing, the t9 Testing module compile view and the
// t11 dependency strip front.
test_transpile_front :: (stage: *Test_Transpile_Stage) -> bool {
    prepared := stage.prepared;
    root_dir := prepared.discovery.root_dir;
    pipeline := stage.pipeline;
    transpile_dir := transpile_tree_dir(root_dir);
    stage.transpile_dir = transpile_dir;

    // PRESTEP consumption (ticket 057): a substituted file reads its EXPAND
    // source from the replacement (the package-relative rel_path stays the
    // original — views, numbering and path_mapping key off the original); a
    // dropped file never enters the test program. Files with no hit keep
    // their original paths. The filtered list replaces the stage's file list,
    // so the t3 loop, the Testing support lookup, the view landing and the
    // embedded driver/path_mapping pairs all stay index-aligned.
    active_files: [..] Scan_File;
    for file: stage.files {
        if prestep_is_dropped(stage.prestep, file.rel_path) continue;
        compiled := file;
        replacement, substituted := prestep_substitution_for(stage.prestep, file.rel_path);
        if substituted {
            compiled.abs_path = path_slashes(replacement);
        }
        array_add(*active_files, compiled);
    }
    stage.files = active_files;

    // t3: transpile every file in list order, numbering tests globally
    // (base 1, continuing across files — ticket 023's caller-side
    // contract). Diagnostics are rejected with the original file
    // coordinates.
    next_number: s64 = 1;
    for file: stage.files {
        output := transpile_test_file(file, next_number, pipeline);
        if output.diagnostics.count > 0 {
            for diagnostic: output.diagnostics {
                print("[juice ERROR] %1:%2,%3: %4\n", file.rel_path, diagnostic.line, diagnostic.column, diagnostic.message);
            }
            return false;
        }
        array_add(*stage.outputs, output);
        next_number += output.tests.count;
    }

    // t9 computation (before the writes): the support view is the expand
    // output of the package's own tests/test_support.jai, when discovered.
    support_view := "";
    for file, index: stage.files {
        if file.rel_path == "tests/test_support.jai" support_view = stage.outputs[index].view;
    }
    module_result, module_ok := testing_module_view(root_dir, support_view, next_number);
    if !module_ok return false;
    if module_result.enabled {
        stage.testing_module_dir = module_result.dir;
        stage.testing_module_view = module_result.view_path;
    }

    // t5/t8: content-addressed view paths for every discovered file: every
    // path derives from the per-file key the transpile step returned; an
    // existing view is a cache hit and stays untouched (content addressing
    // makes stale views unreachable, so there is nothing to invalidate or
    // clean), a missing one is written with the package-relative structure
    // mirrored inside the hash directory.
    if !make_directory_if_it_does_not_exist(transpile_dir, recursive = true) {
        print("[juice ERROR] Could not create the transpile cache directory: %\n", transpile_dir);
        return false;
    }
    for file, index: stage.files {
        view_path := transpile_view_path(transpile_dir, stage.outputs[index].key, file.rel_path);
        array_add(*stage.view_paths, view_path);
        // The parent must exist before the existence check: the inspection
        // scans the parent directory, and a missing parent would make
        // visit_files log a spurious "Unable to open directory" error.
        if !make_directory_if_it_does_not_exist(path_strip_filename(view_path), recursive = true) {
            print("[juice ERROR] Could not create view directory for %\n", file.rel_path);
            return false;
        }
        if path_exists_as_regular_file(view_path) continue;
        if !write_entire_file(view_path, stage.outputs[index].view) {
            print("[juice ERROR] Could not write view for %\n", file.rel_path);
            return false;
        }
    }

    // t9 write: the Testing module compile view is a session product like
    // the test runner entry (regenerated on every run, never cached — its
    // content is the module view plus the driver-specific support block, not
    // the pure transpile output). It lives under target/ directly — outside
    // the transpile tree, whose direct children are the hash directories,
    // deps/ (when a dependency carries test blocks), and test_runner.jai.
    if module_result.enabled {
        if !make_directory_if_it_does_not_exist(module_result.dir, recursive = true) {
            print("[juice ERROR] Could not create Testing module view directory: %\n", module_result.dir);
            return false;
        }
        if !write_entire_file(module_result.view_path, module_result.view_text) {
            print("[juice ERROR] Could not write Testing module view.\n");
            return false;
        }
    }

    // t11: the dependency strip front — the test program compiles
    // dependency sources through import shims; closures containing test
    // blocks are stripped exactly like build's (the shared front, ticket
    // 027). Dependency tests are neither discovered nor executed — the
    // discovery scan never enters dependency packages — this step only
    // makes them compilable.
    return prepare_dependency_strip_views(root_dir);
}

// The test orchestration over a prepared workspace. The PRESTEP, TRANSPILE
// and COMPILE stages dispatch through the lifecycle hook table — the
// declaration-resolved table (ticket 056) followed by the caller's hooks
// (the 004 decision 17 representative subset — the seams' #type parameters
// became the hook-set data parameter): before hooks run first, a mounted at
// hook replaces the stage's built-in implementation (no mount = the built-in
// runs — the empty hook set is the default pipeline; PRESTEP has no built-in
// implementation and never dispatches at), after hooks run last, all in
// registration order (forward — 021). Any hook failure (false or an ERROR
// diagnostic) fails the stage and aborts the test (HANDLER_FAILED through
// the dispatcher). The at replacement's identity enters the pipeline
// description through the pipeline the hook passes to transpile_view_key —
// changing the implementation changes the view keys (documented semantics;
// the built-in front's keys always carry the built-in pipeline description,
// so replaced and built-in views never share a key unless the hook reuses
// the built-in step verbatim, which would be the same implementation).
//
// The collect/spawn seams stay plain #type parameters (not lifecycle
// stages): the zero-FILE short circuit happens before any stage dispatch
// (the PRESTEP stage included), so no hook fires on that path (the ticket
// 027 zero-plan posture).
test_prepared_workspace :: (
    prepared: *Juice.Prepared_Workspace,
    pattern: string,
    hook_table: [] Hook_Registration = .[],
    collect: #type (prepared: *Juice.Prepared_Workspace) -> ([] Scan_File, bool) = collect_test_files,
    spawn: #type (runner_path: string, import_dirs: [] string) -> Process_Result = spawn_test_compiler,
    host_spawn: #type (host_path: string, import_dirs: [] string) -> Process_Result = spawn_plugin_host
) -> bool {
    // Runs once before every test run: the scratch zone (target/tests) is
    // tool-owned test state, so the previous run's fixture roots and E2E
    // caches never accumulate. The crash-recovery zone (target/recovery) is
    // deliberately outside it and survives the prune.
    if !prune_test_scratch(prepared.discovery.root_dir) {
        print("[juice ERROR] Could not prune the test scratch directory: %\n",
              target_tests_dir(package_target_dir(prepared.discovery.root_dir)));
        return false;
    }
    files, ok := collect(prepared);
    if !ok return false;

    // Zero collected files: no test program can exist (the old juice t4
    // short circuit — the compile is skipped entirely, and no stage runs,
    // so no hook fires; the PRESTEP stage included). Zero collected ENTRIES
    // (files exist, no @test procedures) short-circuits inside the
    // generated metaprogram, where the test list becomes known.
    if files.count == 0 {
        print("[juice Test] No tests found.\n");
        return true;
    }

    // Command-level plugin preparation (ticket 060, spec §5.2): the shared
    // prepare is the only scan / member shim / registration landing point.
    // The registration file feeds both the PRESTEP host (member hooks) and
    // the generated test metaprogram (member lint / options); the COMPILE
    // front consumes the returned path and never scans again.
    plugin_prepare := prepare_workspace_plugins(prepared);
    report_plugin_prepare(plugin_prepare);
    if !plugin_prepare.ok return false;

    // The single pipeline resolution for the test command (ticket 056/057):
    // the declaration-driven resolver — resolved once here and handed to
    // the TRANSPILE stage (the front never re-resolves); its hook table
    // joins the dispatch below (the command process holds built-in plugin
    // values only — member values live in the PRESTEP host and the generated
    // metaprogram). The resolved pipeline is the view key's pipeline
    // description.
    resolved := resolve_package_plugins(prepared.discovery.root_package.plugins);
    if !resolved.ok {
        for diagnostic: resolved.diagnostics print("[juice ERROR] %\n", diagnostic.message);
        print("[juice ERROR] Invalid plugin declarations.\n");
        return false;
    }

    // The lifecycle host state: one context per run, one diagnostic sink
    // reused across the stages (each dispatch inspects only its own
    // additions), one plugin_state slot per hook registration (host-owned
    // storage; slots start as the resolver's options pointers for the
    // declared plugins, null for the caller's hooks — the 021 slot
    // protocol). The dispatch table is the declaration-resolved hook table
    // followed by the caller's hooks.
    diags: [..] Lifecycle_Diagnostic;
    lctx: Lifecycle_Context;
    lctx.diagnostics = *diags;
    dispatch_table := merge_hook_tables(resolved.hook_table, hook_table);
    for opt: resolved.slot_options array_add(*lctx.plugin_state, opt);
    for _: hook_table array_add(*lctx.plugin_state, null);

    // PRESTEP stage (t2): no built-in implementation — the before hooks fill
    // the source substitution table and the drop set, the after hooks
    // observe (fail fast on either). The command fills the stage's root and
    // member directories first; with no declared hook plugins both mounts are
    // empty and both tables stay empty — the undeclared no-op, so the
    // TRANSPILE front reads the original sources exactly as before.
    pstage: Prestep_Stage;
    pstage.root_dir = prepared.discovery.root_dir;
    for pkg, index: prepared.discovery.member_packages {
        if index == 0 continue;   // the root package itself
        array_add(*pstage.member_dirs, copy_string(pkg.dir));
    }
    lctx.prestep = *pstage;

    // PRESTEP host (tickets 060/061): member plugins' before hooks run first
    // through the generated host driver (their values are only compiled into
    // that child), and its returned substitution/drop rows merge into this
    // same Prestep_Stage through the stage-level prestep_add_* rules. A
    // table conflict with the caller's in-process hooks is a stage failure.
    if plugin_prepare.member_hooks && plugin_prepare.registration_path != "" {
        host_options := plugin_host_options(prepared, *pstage, "test");
        host_records, host_ok := run_plugin_host(host_options, host_spawn);
        if !host_ok return false;
        if !apply_plugin_host_effects(*pstage, host_records, lctx.diagnostics) return false;
    }

    if !run_mounted_hooks(dispatch_table, .PRESTEP, .before, *lctx) return false;
    if !run_mounted_hooks(dispatch_table, .PRESTEP, .after, *lctx) return false;

    // TRANSPILE stage (t3 + t5-t9 + t11): before -> at (mounted hook
    // replaces the front) | built-in front -> after. The pre-step tables
    // travel with the stage into the per-file EXPAND.
    tstage: Test_Transpile_Stage;
    tstage.prepared = prepared;
    tstage.files = files;
    tstage.pipeline = resolved.pipeline;
    tstage.prestep = *pstage;
    lctx.views = *tstage;
    if !run_mounted_hooks(dispatch_table, .TRANSPILE, .before, *lctx) return false;
    if has_mounted_hook(dispatch_table, .TRANSPILE, .at) {
        if !run_mounted_hooks(dispatch_table, .TRANSPILE, .at, *lctx) return false;
    } else if !test_transpile_front(*tstage) {
        return false;
    }
    if !run_mounted_hooks(dispatch_table, .TRANSPILE, .after, *lctx) return false;

    // COMPILE stage (t12): before -> at | built-in front -> after.
    cstage: Test_Compile_Stage;
    cstage.prepared = prepared;
    cstage.files = tstage.files;
    cstage.view_paths = tstage.view_paths;
    cstage.transpile_dir = tstage.transpile_dir;
    cstage.testing_module_dir = tstage.testing_module_dir;
    cstage.testing_module_view = tstage.testing_module_view;
    cstage.pattern = pattern;
    // The prepare's registration path (ticket 060): the COMPILE front embeds
    // it and never scans/writes the registration itself.
    cstage.registration_path = plugin_prepare.registration_path;
    lctx.artifact_paths = *cstage;
    if !run_mounted_hooks(dispatch_table, .COMPILE, .before, *lctx) return false;
    if has_mounted_hook(dispatch_table, .COMPILE, .at) {
        if !run_mounted_hooks(dispatch_table, .COMPILE, .at, *lctx) return false;
    } else if !test_compile_front(*cstage, spawn) {
        return false;
    }
    if !run_mounted_hooks(dispatch_table, .COMPILE, .after, *lctx) return false;
    return true;
}
