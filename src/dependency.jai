#import "Basic";
#import "File";
#import "File_Utilities";
#import "String";
#import "Process";
#import "Testing";

#import "Juice";

Source_Type :: enum {
    LOCAL_PATH;
    GIT_URL;
}

detect_source_type :: (source: string) -> Source_Type {
    if source == "" return .LOCAL_PATH;
    if starts_with(source, "file://") return .LOCAL_PATH;

    git_schemas :: string.[
        "https://", "http://", "git://", "ssh://", "git+https://", "git+ssh://"
    ];
    for schema: git_schemas {
        if starts_with(source, schema) return .GIT_URL;
    }

    if starts_with(source, "git@") && contains(source, ":") return .GIT_URL;
    if ends_with(source, ".git") return .GIT_URL;
    return .LOCAL_PATH;
}

clean_local_path :: (source: string) -> string {
    if starts_with(source, "file://") return advance(source, 7);
    return source;
}

File_Search_Context :: struct {
    target_name: string;
    results:     [..] string;
}

file_search_visitor :: (info: *File_Visit_Info, user_data: *File_Search_Context) {
    if info.short_name == user_data.target_name {
        array_add(*user_data.results, copy_string(info.full_name));
    }
}

find_files_recursive :: (dir: string, filename: string) -> [..] string {
    ctx: File_Search_Context;
    ctx.target_name = filename;
    visit_files(dir, true, *ctx, file_search_visitor, visit_directories = false);
    return ctx.results;
}

// Local dependency directory（CONTEXT）：<package root>/target/packages/。
// root_dir 的纯推导（票 0038：Build_Driver 拆解后，packages_dir 不再是
// 结构体字段，由其持有者 dependency 模块统一派生）。
packages_dir :: (root_dir: string) -> string {
    return to_forward_slashes(tprint("%1/target/packages", root_dir));
}

// Import directories every compile gets beyond jai's own defaults: the
// juice module directory (adjacent to the running executable, holds
// Testing.jai/Juice.jai) and the package's dependency shim directory when it
// exists. juice_modules_dir is the shared derivation (src/path_safety.jai,
// 票 0036). 票 0048：从 build.jai 移入——packages_dir 的派生持有者，build
// 与 test 共用；此前 test 只注入 modules 目录，root 测试程序的
// "#import <依赖名>"（含 workspace member）全部解析失败。
compiler_import_directories :: (packages_dir: string) -> [..] string {
    dirs: [..] string;
    dirs.allocator = temp;

    global_modules_dir := juice_modules_dir();
    if is_directory(global_modules_dir) array_add(*dirs, global_modules_dir);

    if is_directory(packages_dir) {
        array_add(*dirs, to_forward_slashes(packages_dir));
    }
    return dirs;
}

find_package_in_repo :: (cache_dir: string, repo_dir: string, target_pkg_name: string) -> string, bool {
    manifest_files := find_files_recursive(repo_dir, "package.jai");
    defer array_free(manifest_files);

    for manifest_path: manifest_files {
        pkg_dir := get_directory_path(manifest_path);
        pkg, ok := load_package_manifest(cache_dir, pkg_dir);
        if ok && pkg.name == target_pkg_name return pkg_dir, true;
    }
    return "", false;
}

// Consume the discovery snapshot; never re-execute workspace manifests.
resolve_and_fetch_dependencies :: (root_dir: string, cache_dir: string, member_packages: [] Package) -> bool {
    if !make_directory_if_it_does_not_exist(packages_dir(root_dir), recursive = true) return false;
    return fetch_workspace_dependencies(root_dir, cache_dir, member_packages);
}

// A workspace member is consumed through the local dependency directory: the
// declaring package lists it as a dependency, and preparation registers an
// import shim so consumers resolve it with a plain "#import <name>".
link_workspace_member_dependency :: (root_dir: string, member: Package) -> bool {
    return ensure_import_shim(packages_dir(root_dir), member.name, member.dir);
}

// One import shim's generated content: a comment line plus a single #load of
// the dependency entry (the source entry or, after the dependency strip
// front views the dependency, the entry's strip view). Single source of the
// shim format (dependency_shim_content), shared by preparation and rewrite.
dependency_shim_content :: (name: string, entry: string) -> string {
    return tprint("// Generated by juice: import shim for package '%1'.\n#load \"%2\";\n", name, entry);
}

// "#import <name>" below the dependency directory resolves <name>.jai (a
// plain file). We never link the source directory itself: the compiler
// canonicalizes junctions and rejects imports whose name mismatches the real
// directory, and a directory next to its shim collides as "both single-file
// and directory form". So every dependency gets exactly one generated shim
// that loads the real entry by path. No manifest is required, so plain Jai
// modules work as dependencies too.
ensure_import_shim :: (packages_dir: string, name: string, source_dir: string) -> bool {
    abs_source, ok := normalize_existing_path(source_dir);
    if !ok return false;

    entries :: string.["module.jai", "src/module.jai"];
    for entry: entries {
        candidate := tprint("%1/%2", abs_source, entry);
        if file_exists(candidate) {
            return write_entire_file(tprint("%1/%2.jai", packages_dir, name), dependency_shim_content(name, candidate));
        }
    }

    single_file := tprint("%1/%2.jai", abs_source, name);
    if file_exists(single_file) {
        return write_entire_file(tprint("%1/%2.jai", packages_dir, name), dependency_shim_content(name, single_file));
    }

    // No recognizable layout; leave resolution to the compiler's own error.
    return true;
}

// ---------------------------------------------------------------------------
// 依赖剥离前端（票 0049）：import shim 是进入依赖闭包的入口——消费者以
// `#import <依赖名>` 引用依赖时，编译器经 target/packages 下的 shim 直接
// #load 依赖的导入入口（ADR 0004 剥离保证 = 入口同包闭包，依赖源此前裸传
// jai）。依赖源码内联 test block 后不可被 jai 直接编译，本前端对每个 shim：
// 解析入口路径 → 以依赖包为根探测入口的字面量 in-package #load 闭包
// （probe_package_closure）→ 闭包含 test block 时整闭包生成 STRIP 视图
// （ADR 0004 全有全无语义），落 target/transpile/deps/<依赖名>/...，并把
// shim 的 #load 改写到入口视图。test-free 依赖零转译、shim 原样不动。
// Build 与 Test 共用本前端；依赖中的 test block 不被发现、不执行（Test
// discovery 不扫依赖包），两路径只做剥离编译。
// ---------------------------------------------------------------------------

// The #load target literal of a generated import shim: the dependency entry's
// absolute path. Returns false when the shim does not match the generated
// shape (a hand-written shim stays untouched; the compiler's own error
// reports whatever is wrong with it).
shim_load_target :: (source: string) -> string, bool {
    tokens := lex_source(source);
    i := 0;
    while i < tokens.count {
        tok := tokens[i];
        if tok.kind == .DIRECTIVE && token_text(source, tok) == "#load" && i + 2 < tokens.count
            && tokens[i+1].kind == .STRING && token_text(source, tokens[i+2]) == ";" {
            target := tokens[i+1];
            return decode_jai_string(slice(source, target.start + 1, target.end - target.start - 2)), true;
        }
        i += 1;
    }
    return "", false;
}

// File name (with extension) of a path; the complement of get_directory_path.
get_filename :: (file_path: string) -> string {
    last_slash := -1;
    for i: 0..file_path.count-1 {
        if file_path[i] == #char "/" || file_path[i] == #char "\\" last_slash = i;
    }
    return slice(file_path, last_slash + 1, file_path.count - last_slash - 1);
}

// Deterministic shim enumeration: every *.jai file directly under the
// dependency directory, minus its extension, in lexicographic order.
Shim_Scan_Context :: struct {
    names: [..] string;
}

shim_scan_visitor :: (info: *File_Visit_Info, ctx: *Shim_Scan_Context) {
    if info.is_directory return;
    if info.short_name.count == 0 || info.short_name[0] == #char "." return;
    if !ends_with(info.short_name, ".jai") return;
    array_add(*ctx.names, copy_string(slice(info.short_name, 0, info.short_name.count - 4)));
}

sort_shim_names :: (names: [] string) {
    for i: 1..names.count-1 {
        if i >= names.count break;
        key := names[i];
        j := i - 1;
        while j >= 0 && compare(names[j], key) > 0 {
            names[j+1] = names[j];
            j -= 1;
        }
        names[j+1] = key;
    }
}

collect_shim_names :: (packages_dir: string) -> [..] string, bool {
    ctx: Shim_Scan_Context;
    visited := visit_files(packages_dir, false, *ctx, shim_scan_visitor, visit_directories = false);
    if !visited return ctx.names, false;
    sort_shim_names(ctx.names);
    return ctx.names, true;
}

// One build source file: package-relative path ("/" separated) and absolute
// path, mirroring the test command's Test_Source_File. A dependency closure
// file's rel_path is relative to the dependency package root (views land
// under deps/<name>/..., the path itself stays dependency-relative).
Build_Source_File :: struct {
    rel_path: string;
    abs_path: string;
}

// One probed closure file: its resolved in-package literal #load targets in
// statement order, and whether it contains test blocks.
Build_Closure_File :: struct {
    file:      Build_Source_File;
    loads:     [..] string;
    has_tests: bool;
}

// The transpile step's output for one file: the strip-mode view, the
// content-addressed cache key, and transpile diagnostics (rejected with the
// original file coordinates).
Build_File_Output :: struct {
    view:        string;
    key:         string;
    diagnostics: [..] Transpile_Diagnostic;
}

probe_visited :: (visited: [] string, rel_path: string) -> bool {
    for seen: visited {
        if seen == rel_path return true;
    }
    return false;
}

// Probe one package's closure: DFS from the entry over literal in-package
// #load edges, with `package_root` as the resolution boundary. Non-literal
// and out-of-package targets are not followed (issue 0008 resolution 4).
// Files are listed in DFS preorder — the entry first, then each load
// target's subtree in statement order. The consumer package's build closure
// (build.jai's probe_build_closure) and dependency closures (the strip front
// below) share this probe.
probe_package_closure :: (package_root: string, entry_rel: string) -> [..] Build_Closure_File, bool {
    entry: Build_Source_File;
    entry.rel_path = entry_rel;
    entry.abs_path = to_forward_slashes(tprint("%1/%2", package_root, entry_rel));

    files: [..] Build_Closure_File;
    visited: [..] string;
    stack: [..] Build_Source_File;
    array_add(*stack, entry);

    while stack.count > 0 {
        file := stack[stack.count - 1];
        stack.count -= 1;
        if probe_visited(visited, file.rel_path) continue;
        array_add(*visited, copy_string(file.rel_path));

        source, ok := read_entire_file(file.abs_path);
        if !ok {
            print("[juice ERROR] Could not read source file for build: %\n", file.abs_path);
            return files, false;
        }

        cf: Build_Closure_File;
        cf.file = file;
        cf.has_tests = source_has_test_block(source);
        cf.loads = source_load_targets(source, file.rel_path);
        array_add(*files, cf);

        // Push in reverse so targets pop in statement order.
        i := cf.loads.count;
        while i > 0 {
            i -= 1;
            target: Build_Source_File;
            target.rel_path = cf.loads[i];
            target.abs_path = to_forward_slashes(tprint("%1/%2", package_root, cf.loads[i]));
            array_add(*stack, target);
        }
    }
    return files, true;
}

// Shared state of one closure's view computation: per-file states (0 =
// uncomputed, 1 = computing, 2 = done) and the resulting view paths.
// "Computing" re-entry means the literal in-package #load graph has a
// cycle and the path rewrites cannot be resolved (issue 0008 resolution 2).
// dep_name non-empty marks a dependency closure: views land under
// deps/<dep_name>/ instead of the tree root (票 0049).
Build_View_State :: struct {
    transpile_dir: string;
    dep_name:      string;
    closure:       [] Build_Closure_File;
    transpile:     #type (file: Build_Source_File, load_targets: [] Load_Target) -> Build_File_Output;
    states:        [..] s64;
    view_paths:    [..] string;
    failed:        bool;
}

closure_index :: (state: *Build_View_State, rel_path: string) -> (s64, bool) {
    for i: 0..state.closure.count-1 {
        if state.closure[i].file.rel_path == rel_path return i, true;
    }
    return -1, false;
}

// Compute one closure file's strip view in dependency order (children
// first, Merkle chain) and write it content-addressed into the transpile
// tree. Returns the absolute view path.
view_of_file :: (state: *Build_View_State, index: s64) -> string, bool {
    if state.failed return "", false;
    if state.states[index] == 2 return state.view_paths[index], true;
    if state.states[index] == 1 {
        print("[juice ERROR] %1: 循环加载无法重写路径\n", state.closure[index].file.rel_path);
        state.failed = true;
        return "", false;
    }
    state.states[index] = 1;

    // Children first: every in-package load target is in the closure by
    // construction, so its view path exists before the parent's key embeds
    // it in a load rewrite.
    load_targets: [..] Load_Target;
    for resolved: state.closure[index].loads {
        child_index, found := closure_index(state, resolved);
        if !found {
            print("[juice ERROR] %1: in-package #load 缺少视图目标\n", state.closure[index].file.rel_path);
            state.failed = true;
            return "", false;
        }
        child_path, ok := view_of_file(state, child_index);
        if !ok return "", false;
        target: Load_Target;
        target.from = resolved;
        target.to = child_path;
        array_add(*load_targets, target);
    }

    output := state.transpile(state.closure[index].file, load_targets);
    if output.diagnostics.count > 0 {
        for diagnostic: output.diagnostics {
            print("[juice ERROR] %1:%2,%3: %4\n", state.closure[index].file.rel_path, diagnostic.line, diagnostic.column, diagnostic.message);
        }
        state.failed = true;
        return "", false;
    }

    view_path := ifx state.dep_name == ""
        then transpile_view_path(state.transpile_dir, output.key, state.closure[index].file.rel_path)
        else transpile_dependency_view_path(state.transpile_dir, output.key, state.dep_name, state.closure[index].file.rel_path);
    // The parent must exist before the existence check: the inspection
    // scans the parent directory, and a missing parent would make
    // visit_files log a spurious "Unable to open directory" error.
    if !make_directory_if_it_does_not_exist(path_strip_filename(view_path), recursive = true) {
        print("[juice ERROR] Could not create view directory for %\n", state.closure[index].file.rel_path);
        state.failed = true;
        return "", false;
    }
    if !path_exists_as_regular_file(view_path) {
        if !write_entire_file(view_path, output.view) {
            print("[juice ERROR] Could not write view for %\n", state.closure[index].file.rel_path);
            state.failed = true;
            return "", false;
        }
    }

    state.view_paths[index] = copy_string(view_path);
    state.states[index] = 2;
    return view_path, true;
}

// The dependency strip front shared by build and test: for every import shim
// in the dependency directory, probe the dependency entry's closure; a
// closure containing test blocks is viewed wholesale and the shim is
// regenerated pointing at the entry's strip view. Test-free dependencies,
// missing entries and hand-written shims stay untouched (zero transpile,
// zero cache; the compiler's own error reports whatever is wrong with them).
prepare_dependency_strip_views :: (
    root_dir: string,
    transpile: #type (file: Build_Source_File, load_targets: [] Load_Target) -> Build_File_Output
) -> bool {
    packages := packages_dir(root_dir);
    if !is_directory(packages) return true;

    shims, ok := collect_shim_names(packages);
    if !ok {
        print("[juice ERROR] Could not scan the dependency shim directory: %\n", packages);
        return false;
    }
    for name: shims {
        shim_path := tprint("%1/%2.jai", packages, name);
        source, read_ok := read_entire_file(shim_path);
        if !read_ok continue;
        entry_abs, parsed := shim_load_target(source);
        if !parsed || !path_exists_as_regular_file(entry_abs) continue;

        closure, probe_ok := probe_package_closure(get_directory_path(entry_abs), get_filename(entry_abs));
        if !probe_ok return false;
        has_tests := false;
        for file: closure {
            if file.has_tests {
                has_tests = true;
                break;
            }
        }
        if !has_tests continue;

        state: Build_View_State;
        state.transpile_dir = transpile_tree_dir(root_dir);
        state.dep_name = name;
        state.closure = closure;
        state.transpile = transpile;
        for _: closure {
            array_add(*state.states, 0);
            array_add(*state.view_paths, "");
        }
        entry_view, view_ok := view_of_file(*state, 0);   // DFS preorder: entry first
        if !view_ok return false;

        if !write_entire_file(shim_path, dependency_shim_content(name, entry_view)) {
            print("[juice ERROR] Could not rewrite import shim for dependency '%'.\n", name);
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// 内联测试（票 0049）：依赖剥离前端——shim 解析、test-free 依赖零动作、
// 含 test 闭包的视图生成与 shim 改写、`..` 逃逸 #load 保持 verbatim、
// 坏 shim 留给编译器。共享 fake（fake_build_transpile、记录全局、
// build_seam_write、reset_build_seam）见 tests/test_support.jai。
// ---------------------------------------------------------------------------

test "Dependency strip: shim load target parses the generated shape" {
    entry, ok := shim_load_target(dependency_shim_content("packrat", "C:/repo/src/module.jai"));
    expect(ok && entry == "C:/repo/src/module.jai");
    _, parsed := shim_load_target("// hand-written\nsome_decl :: 1;\n");
    expect(!parsed);
}

test "Dependency strip: a test-free dependency stays untouched" {
    root := tprint("%1/target/dep-strip-clean", juice_root());
    delete_directory_full(root);
    defer delete_directory_full(root);
    dep := tprint("%1/dep", root);
    expect(build_seam_write(dep, "src/module.jai", "#load \"extra.jai\";\nmain_decl :: () -> s32 { return 1; }\n"));
    expect(build_seam_write(dep, "src/extra.jai", "extra_decl :: () -> s32 { return 2; }\n"));
    expect(build_seam_write(root, "target/packages/depx.jai", dependency_shim_content("depx", tprint("%1/src/module.jai", dep))));

    reset_build_seam();
    expect(prepare_dependency_strip_views(root, fake_build_transpile));
    expect(test_build_transpile_calls == 0);
    // shim 原样不动（无剥离、无重写）。
    shim, ok := read_entire_file(tprint("%1/target/packages/depx.jai", root));
    expect(ok && shim == dependency_shim_content("depx", tprint("%1/src/module.jai", dep)));
    expect(!file_exists(tprint("%1/target/transpile", root)));
}

test "Dependency strip: a test closure is viewed and the shim rewritten" {
    root := tprint("%1/target/dep-strip-view", juice_root());
    delete_directory_full(root);
    defer delete_directory_full(root);
    dep := tprint("%1/dep", root);
    expect(build_seam_write(dep, "src/module.jai", "#load \"extra.jai\";\nmain_decl :: () -> s32 { return 1; }\n"));
    expect(build_seam_write(dep, "src/extra.jai", "extra_decl :: () -> s32 { return 2; }\n\ntest \"dep test\" {\n}\n"));
    expect(build_seam_write(root, "target/packages/depx.jai", dependency_shim_content("depx", tprint("%1/src/module.jai", dep))));

    reset_build_seam();
    expect(prepare_dependency_strip_views(root, fake_build_transpile));

    // 整闭包视图化，子先父后（Merkle 链）：extra.jai 先于 module.jai。
    // rel 以依赖包根（入口所在目录 <dep>/src）为基准。
    expect(test_build_transpile_calls == 2);
    expect(test_build_transpiled_files.count == 2);
    expect(test_build_transpiled_files[0] == "extra.jai" && test_build_transpiled_files[1] == "module.jai");
    // 入口的 load 改写指向子视图（deps/<名> 子树）。
    extra_view := tprint("%1/target/transpile/deps/depx/%2/extra.jai", root, fake_key("extra.jai"));
    expect(test_build_transpiled_rewrites.count == 1);
    expect(test_build_transpiled_rewrites[0] == tprint("extra.jai -> %1", extra_view));
    // 视图落 deps/depx 子树；shim 改写指向入口视图。
    entry_view := tprint("%1/target/transpile/deps/depx/%2/module.jai", root, fake_key("module.jai"));
    expect(file_exists(entry_view) && file_exists(extra_view));
    shim, ok := read_entire_file(tprint("%1/target/packages/depx.jai", root));
    expect(ok && shim == dependency_shim_content("depx", entry_view));
}

test "Dependency strip: an escaping load stays verbatim and unviewed" {
    root := tprint("%1/target/dep-strip-escape", juice_root());
    delete_directory_full(root);
    defer delete_directory_full(root);
    dep := tprint("%1/dep", root);
    expect(build_seam_write(dep, "src/module.jai", "#load \"extra.jai\";\nmain_decl :: () -> s32 { return 1; }\n"));
    // `..` 逃逸出依赖包根（src/ 之上）：out-of-package，不跟进、不重写
    // （issue 0008 决议 4）。
    expect(build_seam_write(dep, "src/extra.jai", "#load \"../../outside.jai\";\nextra_decl :: () -> s32 { return 2; }\n\ntest \"dep test\" {\n}\n"));
    expect(build_seam_write(dep, "outside.jai", "outside_decl :: () -> s32 { return 3; }\n"));
    expect(build_seam_write(root, "target/packages/depx.jai", dependency_shim_content("depx", tprint("%1/src/module.jai", dep))));

    reset_build_seam();
    expect(prepare_dependency_strip_views(root, fake_build_transpile));
    expect(test_build_transpile_calls == 2);
    expect(test_build_transpiled_files.count == 2);
    expect(test_build_transpiled_files[0] == "extra.jai" && test_build_transpiled_files[1] == "module.jai");
    // outside.jai 不在闭包、不被视图化：无第三个转译调用。
    expect(!file_exists(tprint("%1/target/transpile/deps/depx/%2/outside.jai", root, fake_key("outside.jai"))));
}

test "Dependency strip: missing entry or bad shim is left to the compiler" {
    root := tprint("%1/target/dep-strip-bad", juice_root());
    delete_directory_full(root);
    defer delete_directory_full(root);
    expect(build_seam_write(root, "target/packages/missing.jai", dependency_shim_content("missing", tprint("%1/nope/src/module.jai", root))));
    expect(build_seam_write(root, "target/packages/handwritten.jai", "// not generated\nsome_decl :: 1;\n"));

    reset_build_seam();
    expect(prepare_dependency_strip_views(root, fake_build_transpile));
    expect(test_build_transpile_calls == 0);
    // 两个 shim 都原样保留。
    shim, ok := read_entire_file(tprint("%1/target/packages/missing.jai", root));
    expect(ok && shim == dependency_shim_content("missing", tprint("%1/nope/src/module.jai", root)));
}

test "Dependency strip: no shim directory is a no-op" {
    reset_build_seam();
    expect(prepare_dependency_strip_views(tprint("%1/target/dep-strip-nodir", juice_root()), fake_build_transpile));
    expect(test_build_transpile_calls == 0);
}

find_workspace_member :: (member_packages: [] Package, name: string) -> Package, bool {
    for pkg: member_packages {
        if pkg.name == name return pkg, true;
    }
    return .{}, false;
}

fetch_workspace_dependencies :: (
    root_dir: string,
    cache_dir: string,
    member_packages: [] Package,
    fetch: #type (root_dir: string, cache_dir: string, dep: Dependency) -> bool = fetch_dependency,
    link_member: #type (root_dir: string, member: Package) -> bool = link_workspace_member_dependency
) -> bool {
    for pkg: member_packages {
        for dep: pkg.dependencies {
            member, is_member := find_workspace_member(member_packages, dep.name);
            if is_member {
                if !link_member(root_dir, member) {
                    print("[juice ERROR] Failed to link workspace member: %1\n", dep.name);
                    return false;
                }
                continue;
            }
            if !fetch(root_dir, cache_dir, dep) {
                print("[juice ERROR] Failed to fetch dependency: %1\n", dep.name);
                return false;
            }
        }
    }
    return true;
}

fetch_dependency :: (root_dir: string, cache_dir: string, dep: Dependency) -> bool {
    source_type := detect_source_type(dep.source);

    if source_type == {
        case .LOCAL_PATH;
            clean_path := clean_local_path(dep.source);
            return ensure_import_shim(packages_dir(root_dir), dep.name, clean_path);

        case .GIT_URL;
            git_cache_base := tprint("%1/git_repos", cache_dir);
            repo_cache_dir := get_git_repo_cache_path(git_cache_base, dep.source, dep.version);

            if !ensure_git_repo_cloned(dep.source, dep.version, repo_cache_dir) return false;

            target_name := ifx dep.package != "" then dep.package else dep.name;
            sub_pkg_dir, found := find_package_in_repo(cache_dir, repo_cache_dir, target_name);
            if !found {
                // The repo may be a plain Jai module (no package.jai); its root
                // is the module directory.
                if file_exists(tprint("%1/module.jai", repo_cache_dir)) {
                    sub_pkg_dir = repo_cache_dir;
                } else {
                    print("[juice ERROR] Package '%1' not found in Git repo %2!\n", target_name, dep.source);
                    return false;
                }
            }

            return ensure_import_shim(packages_dir(root_dir), dep.name, sub_pkg_dir);
    }
    return false;
}

get_directory_path :: (file_path: string) -> string {
    if file_path == "" return "";

    last_slash := -1;
    for i: 0..file_path.count-1 {
        ch := file_path[i];
        if ch == #char "/" || ch == #char "\\" last_slash = i;
    }

    if last_slash == -1 return ".";
    if last_slash == 0 return "/";
    return slice(file_path, 0, last_slash);
}

get_git_repo_cache_path :: (base_dir: string, url: string, version: string) -> string {
    builder: String_Builder;
    for i: 0..url.count-1 {
        ch := url[i];
        if (ch >= #char "a" && ch <= #char "z") ||
           (ch >= #char "A" && ch <= #char "Z") ||
           (ch >= #char "0" && ch <= #char "9") {
            append(*builder, ch);
        } else {
            append(*builder, #char "_");
        }
    }

    if version != "" print_to_builder(*builder, "_%", version);
    sanitized := builder_to_string(*builder);
    return tprint("%1/%2", base_dir, sanitized);
}

ensure_git_repo_cloned :: (url: string, version: string, dst_dir: string) -> bool {
    if file_exists(dst_dir) {
        res_fetch := run_command("git", "-C", dst_dir, "fetch", "--all");
        if res_fetch.exit_code != 0 return false;
    } else {
        res_clone := run_command("git", "clone", url, dst_dir);
        if res_clone.exit_code != 0 return false;
    }

    if version != "" {
        res_checkout := run_command("git", "-C", dst_dir, "checkout", version);
        if res_checkout.exit_code != 0 return false;
    }
    return true;
}

delete_directory_full :: (path: string) -> bool {
    if !file_exists(path) && !path_is_symlink(path) return true;
    #if OS == .WINDOWS {
        // rmdir parses forward-slash path segments as option switches, so the
        // argument must use backslashes throughout.
        res := run_command("cmd", "/c", "rmdir", "/S", "/Q", path_backslashes(path));
        return res.exit_code == 0;
    } else {
        res := run_command("rm", "-rf", path);
        return res.exit_code == 0;
    }
}
